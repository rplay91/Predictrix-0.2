      <data key="d6">40</data>
      <data key="d7">3ce7c210a21b4deebad7cc9308148d86</data>
    </node>
    <node id="MARCELO">
      <data key="d0">PERSON</data>
      <data key="d1">Marcel is a full-time student at SMAK Kolese Santo Yusup Malang who engages in various organizational activities and enjoys hobbies that bring value to his life.</data>
