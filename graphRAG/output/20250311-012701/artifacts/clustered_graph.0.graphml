      <data key="d5">2</data>
      <data key="d6">9</data>
      <data key="d7">27f9fbe6ad8c4a8b9acee0d3596ed57c</data>
    </node>
    <node id="MILLING PROCESS">
      <data key="d0">EVENT</data>
      <data key="d1">The milling process involves grinding roasted coffee beans to prepare them for brewing.</data>
      <data key="d2">048269ae298e29136a527a89c01376b0</data>
