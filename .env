# Backend runtime
PORT=4030
AUTH_ENABLED=1

# CORS (leave empty for same-origin)
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ALL=

# Database
DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASS=YOUR_DB_PASS

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional local model path
BGE_M3_MODEL_PATH=